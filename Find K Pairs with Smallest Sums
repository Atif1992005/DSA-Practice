/*
Find K Pairs with Smallest Sums

Given two sorted arrays, find k pairs having
the smallest sums.

Each pair contains one element from each array.

Example:
Input:
3
1 7 11
3
2 4 6
3

Output:
1 2
1 4
1 6
*/

import java.util.*;

public class KSmallestPairs {

    static class Pair {
        int i,j,sum;

        Pair(int i,int j,int sum) {
            this.i=i;
            this.j=j;
            this.sum=sum;
        }
    }

    static void solve(int[] a,int[] b,int k) {
        PriorityQueue<Pair> q=new PriorityQueue<>(
            (x,y)->x.sum-y.sum
        );

        for(int i=0;i<a.length && i<k;i++) {
            q.add(new Pair(i,0,a[i]+b[0]));
        }

        int count=0;

        while(!q.isEmpty() && count<k) {
            Pair p=q.remove();

            System.out.println(a[p.i]+" "+b[p.j]);
            count++;

            if(p.j+1<b.length) {
                int j=p.j+1;
                q.add(new Pair(p.i,j,a[p.i]+b[j]));
            }
        }
    }

    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);

        int n=sc.nextInt();
        int[] a=new int[n];

        for(int i=0;i<n;i++)
            a[i]=sc.nextInt();

        int m=sc.nextInt();
        int[] b=new int[m];

        for(int i=0;i<m;i++)
            b[i]=sc.nextInt();

        int k=sc.nextInt();

        solve(a,b,k);
    }
}
