/*
Perfect Squares

Problem:

Given an integer n, return the minimum number of perfect square
numbers that add up to n.

A perfect square is a number that can be written as the product
of an integer with itself.

Example:
Input:
12

Output:
3

Explanation:
12 = 4 + 4 + 4
*/

import java.util.*;

public class PerfectSquares {

  static int numSquares(int n) {
    int[] dp=new int[n+1];
    Arrays.fill(dp,n+1);
    dp[0]=0;

    for(int i=1;i<=n;i++) {
      for(int j=1;j*j<=i;j++)
        dp[i]=Math.min(dp[i],dp[i-j*j]+1);
    }

    return dp[n];
  }

  public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);

    int n=sc.nextInt();

    System.out.println(numSquares(n));
  }
}
