/*
Palindrome Linked List

Problem:
Given the head of a singly linked list, determine whether it is a palindrome.

Return true if it is a palindrome, otherwise return false.

Example:
Input:
1 -> 2 -> 2 -> 1

Output:
true
*/

import java.util.*;

class Node {
  int d;
  Node next;

  Node(int x) {
    d=x;
  }
}

public class PalindromeLinkedList {

  static boolean check(Node h) {
    ArrayList<Integer> a=new ArrayList<>();

    while(h!=null) {
      a.add(h.d);
      h=h.next;
    }

    int l=0,r=a.size()-1;

    while(l<r) {
      if(!a.get(l).equals(a.get(r)))
        return false;

      l++;
      r--;
    }

    return true;
  }

  public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);

    int n=sc.nextInt();
    Node h=null,t=null;

    for(int i=0;i<n;i++) {
      Node x=new Node(sc.nextInt());

      if(h==null) {
        h=x;
        t=x;
      }
      else {
        t.next=x;
        t=x;
      }
    }

    System.out.println(check(h));
  }
}
