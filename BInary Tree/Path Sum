/*
Path Sum

Problem:

Given the root of a binary tree and an integer targetSum,
check if the tree has a root-to-leaf path such that the sum
of all node values on the path equals targetSum.

A leaf is a node that has no left or right child.

Example:
Input:
5 4 8 11 null 13 4 7 2 null null null 1
targetSum = 22

Output:
true
*/

import java.util.*;

public class PathSum {

  static class Node {
    int val;
    Node left,right;

    Node(int x) {
      val=x;
    }
  }

  static Node build(String[] a) {
    if(a.length==0 || a[0].equals("null"))
      return null;

    Node root=new Node(Integer.parseInt(a[0]));
    Queue<Node> q=new LinkedList<>();
    q.add(root);

    int i=1;

    while(!q.isEmpty() && i<a.length) {
      Node x=q.remove();

      if(i<a.length && !a[i].equals("null")) {
        x.left=new Node(Integer.parseInt(a[i]));
        q.add(x.left);
      }
      i++;

      if(i<a.length && !a[i].equals("null")) {
        x.right=new Node(Integer.parseInt(a[i]));
        q.add(x.right);
      }
      i++;
    }

    return root;
  }

  static boolean pathSum(Node root,int t) {
    if(root==null)
      return false;

    if(root.left==null && root.right==null)
      return t==root.val;

    return pathSum(root.left,t-root.val) ||
           pathSum(root.right,t-root.val);
  }

  public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);

    int n=sc.nextInt();
    String[] a=new String[n];

    for(int i=0;i<n;i++)
      a[i]=sc.next();

    int t=sc.nextInt();

    Node root=build(a);

    System.out.println(pathSum(root,t));
  }
}
