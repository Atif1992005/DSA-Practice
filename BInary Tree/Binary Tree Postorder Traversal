/*
Binary Tree Postorder Traversal

Problem:

Given the root of a binary tree, return the values of its nodes
in postorder traversal.

In postorder traversal, nodes are visited in this order:
Left -> Right -> Root

Example:
Input:
1 null 2 3

Output:
[3,2,1]
*/

import java.util.*;

public class BinaryTreePostorderTraversal {

  static class Node {
    int val;
    Node left,right;

    Node(int x) {
      val=x;
    }
  }

  static Node build(String[] a) {
    if(a.length==0 || a[0].equals("null"))
      return null;

    Node root=new Node(Integer.parseInt(a[0]));
    Queue<Node> q=new LinkedList<>();
    q.add(root);

    int i=1;

    while(!q.isEmpty() && i<a.length) {
      Node x=q.remove();

      if(i<a.length && !a[i].equals("null")) {
        x.left=new Node(Integer.parseInt(a[i]));
        q.add(x.left);
      }
      i++;

      if(i<a.length && !a[i].equals("null")) {
        x.right=new Node(Integer.parseInt(a[i]));
        q.add(x.right);
      }
      i++;
    }

    return root;
  }

  static void postorder(Node root) {
    if(root==null)
      return;

    postorder(root.left);

    postorder(root.right);

    System.out.print(root.val+" ");
  }

  public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);

    int n=sc.nextInt();
    String[] a=new String[n];

    for(int i=0;i<n;i++)
      a[i]=sc.next();

    Node root=build(a);

    postorder(root);
  }
}
