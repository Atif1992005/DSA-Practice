/*
Diameter of Binary Tree

Problem:

Given the root of a binary tree, find the length of the
longest path between any two nodes.

The length of a path is measured by the number of edges
between the nodes.

Example:
Input:
1 2 3 4 5

Output:
3

Explanation:
The longest path is 4 -> 2 -> 1 -> 3, which has 3 edges.
*/

import java.util.*;

public class DiameterOfBinaryTree {

  static class Node {
    int val;
    Node left,right;

    Node(int x) {
      val=x;
    }
  }

  static Node build(String[] a) {
    if(a.length==0 || a[0].equals("null"))
      return null;

    Node root=new Node(Integer.parseInt(a[0]));
    Queue<Node> q=new LinkedList<>();
    q.add(root);

    int i=1;

    while(!q.isEmpty() && i<a.length) {
      Node x=q.remove();

      if(i<a.length && !a[i].equals("null")) {
        x.left=new Node(Integer.parseInt(a[i]));
        q.add(x.left);
      }
      i++;

      if(i<a.length && !a[i].equals("null")) {
        x.right=new Node(Integer.parseInt(a[i]));
        q.add(x.right);
      }
      i++;
    }

    return root;
  }

  static int ans=0;

  static int height(Node root) {
    if(root==null)
      return 0;

    int l=height(root.left);
    int r=height(root.right);

    ans=Math.max(ans,l+r);

    return 1+Math.max(l,r);
  }

  static int diameter(Node root) {
    ans=0;
    height(root);
    return ans;
  }

  public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);

    int n=sc.nextInt();
    String[] a=new String[n];

    for(int i=0;i<n;i++)
      a[i]=sc.next();

    Node root=build(a);

    System.out.println(diameter(root));
  }
}
