/*
Minimum Value in a BST

Problem:

Given the root of a Binary Search Tree (BST), find the smallest
value present in the tree.

In a BST, smaller values are stored in the left subtree.
Therefore, the minimum value is found at the leftmost node.

If the tree is empty, return -1.

Example:
Input:
4 2 7 1 3

Output:
1
*/

import java.util.*;

public class MinimumValueBST {

  static class Node {
    int val;
    Node left,right;

    Node(int x) {
      val=x;
    }
  }

  static Node insert(Node root,int x) {
    if(root==null)
      return new Node(x);

    if(x<root.val)
      root.left=insert(root.left,x);
    else if(x>root.val)
      root.right=insert(root.right,x);

    return root;
  }

  static Node build(String[] a) {
    Node root=null;

    for(String s:a) {
      if(!s.equals("null"))
        root=insert(root,Integer.parseInt(s));
    }

    return root;
  }

  static int minValue(Node root) {
    if(root==null)
      return -1;

    while(root.left!=null)
      root=root.left;

    return root.val;
  }

  public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);

    int n=sc.nextInt();
    String[] a=new String[n];

    for(int i=0;i<n;i++)
      a[i]=sc.next();

    Node root=build(a);

    System.out.println(minValue(root));
  }
}
