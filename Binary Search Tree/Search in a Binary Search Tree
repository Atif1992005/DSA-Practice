/*
Search in a Binary Search Tree

Problem:

Given the root of a Binary Search Tree (BST) and an integer value,
find the node containing that value.

In a BST:
- Values smaller than a node are on the left.
- Values greater than a node are on the right.

If the value is not present, return -1.

Example:
Input:
4 2 7 1 3
target = 2

Output:
2
*/

import java.util.*;

public class SearchInBST {

  static class Node {
    int val;
    Node left,right;

    Node(int x) {
      val=x;
    }
  }

  static Node build(String[] a) {
    if(a.length==0)
      return null;

    Node root=new Node(Integer.parseInt(a[0]));
    Queue<Node> q=new LinkedList<>();
    q.add(root);

    int i=1;

    while(!q.isEmpty() && i<a.length) {
      Node x=q.remove();

      if(i<a.length && !a[i].equals("null")) {
        x.left=new Node(Integer.parseInt(a[i]));
        q.add(x.left);
      }
      i++;

      if(i<a.length && !a[i].equals("null")) {
        x.right=new Node(Integer.parseInt(a[i]));
        q.add(x.right);
      }
      i++;
    }

    return root;
  }

  static Node search(Node root,int t) {
    while(root!=null) {
      if(root.val==t)
        return root;

      if(t<root.val)
        root=root.left;
      else
        root=root.right;
    }

    return null;
  }

  public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);

    int n=sc.nextInt();
    String[] a=new String[n];

    for(int i=0;i<n;i++)
      a[i]=sc.next();

    int t=sc.nextInt();

    Node root=build(a);
    Node ans=search(root,t);

    if(ans!=null)
      System.out.println(ans.val);
    else
      System.out.println(-1);
  }
}
