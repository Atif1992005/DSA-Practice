/*
Convert Sorted Array to Binary Search Tree

Problem:

Given an integer array sorted in ascending order, convert it
into a height-balanced Binary Search Tree (BST).

A height-balanced tree is a tree in which the heights of the
left and right subtrees differ by at most 1 for every node.

Example:
Input:
[-10,-3,0,5,9]

Output:
[0,-3,9,-10,null,5]
*/

import java.util.*;

public class SortedArrayToBST {

  static class Node {
    int val;
    Node left,right;

    Node(int x) {
      val=x;
    }
  }

  static Node convert(int[] a,int l,int r) {
    if(l>r)
      return null;

    int m=(l+r)/2;
    Node root=new Node(a[m]);

    root.left=convert(a,l,m-1);
    root.right=convert(a,m+1,r);

    return root;
  }

  static void print(Node root) {
    if(root==null) {
      System.out.print("null ");
      return;
    }

    Queue<Node> q=new LinkedList<>();
    q.add(root);

    while(!q.isEmpty()) {
      Node x=q.remove();

      if(x==null) {
        System.out.print("null ");
        continue;
      }

      System.out.print(x.val+" ");
      q.add(x.left);
      q.add(x.right);
    }
  }

  public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);

    int n=sc.nextInt();
    int[] a=new int[n];

    for(int i=0;i<n;i++)
      a[i]=sc.nextInt();

    Node root=convert(a,0,n-1);

    print(root);
  }
}
