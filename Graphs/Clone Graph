/*
Clone Graph

Given an undirected connected graph, create a deep copy.

Each node has a value and a list of neighboring nodes.

The cloned graph must have new nodes with the
same connections as the original graph.

Example:
Input:
4
1 2 4
2 1 3
3 2 4
4 1 3

Output:
1: 2 4
2: 1 3
3: 2 4
4: 1 3
*/

import java.util.*;

public class CloneGraph {

    static class Node {
        int val;
        ArrayList<Node> adj=new ArrayList<>();

        Node(int val) {
            this.val=val;
        }
    }

    static HashMap<Integer,Node> map=new HashMap<>();

    static Node clone(Node node) {
        if(node==null)
            return null;

        if(map.containsKey(node.val))
            return map.get(node.val);

        Node copy=new Node(node.val);
        map.put(node.val,copy);

        for(Node x:node.adj) {
            copy.adj.add(clone(x));
        }

        return copy;
    }

    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);

        int n=sc.nextInt();

        Node[] a=new Node[n+1];

        for(int i=1;i<=n;i++)
            a[i]=new Node(i);

        for(int i=1;i<=n;i++) {
            int m=sc.nextInt();

            for(int j=0;j<m;j++) {
                int x=sc.nextInt();
                a[i].adj.add(a[x]);
            }
        }

        Node ans=clone(a[1]);

        for(int i=1;i<=n;i++) {
            System.out.print(ans.val+": ");

            for(Node x:ans.adj)
                System.out.print(x.val+" ");

            System.out.println();

            ans=map.get(i+1);
            if(ans==null)
                break;
        }
    }
}
