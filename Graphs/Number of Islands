/*
Number of Islands

Given a grid containing 1 and 0.

1 represents land.
0 represents water.

Connected land cells form an island.
Only horizontal and vertical connections count.

Find the total number of islands.

Example:
Input:
4 5
1 1 0 0 0
1 1 0 0 1
0 0 1 0 1
0 0 0 1 1

Output:
3
*/

import java.util.*;

public class NumberOfIslands {

    static int r,c;

    static void dfs(int[][] a,int i,int j) {
        if(i<0 || j<0 || i>=r || j>=c || a[i][j]==0)
            return;

        a[i][j]=0;

        dfs(a,i+1,j);
        dfs(a,i-1,j);
        dfs(a,i,j+1);
        dfs(a,i,j-1);
    }

    static int solve(int[][] a) {
        int count=0;

        for(int i=0;i<r;i++) {
            for(int j=0;j<c;j++) {
                if(a[i][j]==1) {
                    count++;
                    dfs(a,i,j);
                }
            }
        }

        return count;
    }

    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);

        r=sc.nextInt();
        c=sc.nextInt();

        int[][] a=new int[r][c];

        for(int i=0;i<r;i++) {
            for(int j=0;j<c;j++) {
                a[i][j]=sc.nextInt();
            }
        }

        System.out.println(solve(a));
    }
}
