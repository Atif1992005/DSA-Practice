/*
Trapping Rain Water

Problem:
Given an array representing the height of bars, calculate how much rainwater can be trapped between them after rainfall.

Example:
Input:
[0,1,0,2,1,0,1,3,2,1,2,1]

Output:
6
*/

import java.util.*;

public class TrappingRainWater {

  static int rain(int[] a) {
    int l=0,r=a.length-1;
    int lm=0,rm=0,ans=0;

    while(l<r) {
      if(a[l]<=a[r]) {
        if(a[l]>=lm)
          lm=a[l];
        else
          ans+=lm-a[l];
        l++;
      }
      else {
        if(a[r]>=rm)
          rm=a[r];
        else
          ans+=rm-a[r];
        r--;
      }
    }

    return ans;
  }

  public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);

    int n=sc.nextInt();
    int[] a=new int[n];

    for(int i=0;i<n;i++)
      a[i]=sc.nextInt();

    System.out.println(rain(a));
  }
}
