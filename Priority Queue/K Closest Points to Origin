/*
K Closest Points to Origin

Problem:

Given an array of points where points[i] = [x,y], find the
k closest points to the origin (0,0).

The distance is calculated using:
distance = x*x + y*y

Return the k closest points.

Example:
Input:
points = [[1,3],[-2,2],[5,8]]
k = 2

Output:
[[1,3],[-2,2]]
*/

import java.util.*;

public class KClosestPoints {

  static int[][] kClosest(int[][] a,int k) {
    PriorityQueue<int[]> q=new PriorityQueue<>(
      (x,y)->Integer.compare(
        y[0]*y[0]+y[1]*y[1],
        x[0]*x[0]+x[1]*x[1]
      )
    );

    for(int[] p:a) {
      q.add(p);

      if(q.size()>k)
        q.remove();
    }

    int[][] ans=new int[k][2];

    for(int i=0;i<k;i++)
      ans[i]=q.remove();

    return ans;
  }

  public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);

    int n=sc.nextInt();
    int[][] a=new int[n][2];

    for(int i=0;i<n;i++) {
      a[i][0]=sc.nextInt();
      a[i][1]=sc.nextInt();
    }

    int k=sc.nextInt();

    int[][] ans=kClosest(a,k);

    for(int[] p:ans)
      System.out.println(Arrays.toString(p));
  }
}
