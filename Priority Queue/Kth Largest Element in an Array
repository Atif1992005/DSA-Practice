/*
Kth Largest Element in an Array

Problem:

Given an integer array nums and an integer k, find the kth
largest element in the array.

The kth largest element is based on sorted order, not the
kth distinct element.

Example:
Input:
nums = [3,2,1,5,6,4]
k = 2

Output:
5
*/

import java.util.*;

public class KthLargestElement {

  static int findKthLargest(int[] a,int k) {
    PriorityQueue<Integer> q=new PriorityQueue<>();

    for(int x:a) {
      q.add(x);

      if(q.size()>k)
        q.remove();
    }

    return q.peek();
  }

  public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);

    int n=sc.nextInt();
    int[] a=new int[n];

    for(int i=0;i<n;i++)
      a[i]=sc.nextInt();

    int k=sc.nextInt();

    System.out.println(findKthLargest(a,k));
  }
}
