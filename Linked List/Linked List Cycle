/*
Linked List Cycle

Problem:
Given the head of a linked list, determine whether the linked list contains a cycle.

Return true if there is a cycle, otherwise return false.

*/

import java.util.*;

class Node {
  int d;
  Node next;

  Node(int x) {
    d=x;
  }
}

public class LinkedListCycle {

  static boolean check(Node h) {

    Node s=h,f=h;

    while(f!=null && f.next!=null) {
      s=s.next;
      f=f.next.next;

      if(s==f)
        return true;
    }

    return false;
  }

  public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);

    int n=sc.nextInt();
    Node[] a=new Node[n];

    for(int i=0;i<n;i++)
      a[i]=new Node(sc.nextInt());

    for(int i=0;i<n-1;i++)
      a[i].next=a[i+1];

    int x=sc.nextInt();

    if(x!=-1)
      a[n-1].next=a[x];

    System.out.println(check(a[0]));
  }
}
