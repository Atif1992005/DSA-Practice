/*
Merge Two Sorted Lists

Problem:
You are given the heads of two sorted linked lists.

Merge the two lists into one sorted linked list and return its head.

Example:
Input:
List1: 1 -> 2 -> 4
List2: 1 -> 3 -> 4

Output:
1 -> 1 -> 2 -> 3 -> 4 -> 4
*/

import java.util.*;

class Node {
  int d;
  Node next;

  Node(int x) {
    d=x;
  }
}

public class MergeTwoSortedLists {

  static Node merge(Node a,Node b) {

    Node x=new Node(0),t=x;

    while(a!=null && b!=null) {

      if(a.d<=b.d) {
        t.next=a;
        a=a.next;
      }
      else {
        t.next=b;
        b=b.next;
      }

      t=t.next;
    }

    if(a!=null)
      t.next=a;
    else
      t.next=b;

    return x.next;
  }

  static void show(Node h) {
    while(h!=null) {
      System.out.print(h.d);
      if(h.next!=null)
        System.out.print(" -> ");
      h=h.next;
    }
  }

  public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);

    int n1=sc.nextInt();
    Node h1=null,t1=null;

    for(int i=0;i<n1;i++) {
      Node x=new Node(sc.nextInt());

      if(h1==null) {
        h1=x;
        t1=x;
      }
      else {
        t1.next=x;
        t1=x;
      }
    }

    int n2=sc.nextInt();
    Node h2=null,t2=null;

    for(int i=0;i<n2;i++) {
      Node x=new Node(sc.nextInt());

      if(h2==null) {
        h2=x;
        t2=x;
      }
      else {
        t2.next=x;
        t2=x;
      }
    }

    show(merge(h1,h2));
  }
}
