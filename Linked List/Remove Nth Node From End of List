/*
Remove Nth Node From End of List

Problem:
Given the head of a linked list, remove the nth node from the end of the list and return its head.

Example:
Input:
1 -> 2 -> 3 -> 4 -> 5
n = 2

Output:
1 -> 2 -> 3 -> 5
*/

import java.util.*;

class Node {
  int d;
  Node next;

  Node(int x) {
    d=x;
  }
}

public class RemoveNthNodeFromEnd {

  static Node rem(Node h,int n) {

    Node x=new Node(0);
    x.next=h;

    Node a=x,b=x;

    for(int i=0;i<=n;i++)
      a=a.next;

    while(a!=null) {
      a=a.next;
      b=b.next;
    }

    b.next=b.next.next;

    return x.next;
  }

  static void show(Node h) {
    while(h!=null) {
      System.out.print(h.d);
      if(h.next!=null)
        System.out.print(" -> ");
      h=h.next;
    }
  }

  public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);

    int n=sc.nextInt();

    Node h=null,t=null;

    for(int i=0;i<n;i++) {
      Node x=new Node(sc.nextInt());

      if(h==null) {
        h=x;
        t=x;
      }
      else {
        t.next=x;
        t=x;
      }
    }

    int k=sc.nextInt();

    h=rem(h,k);

    show(h);
  }
}
