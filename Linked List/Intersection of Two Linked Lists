/*
Intersection of Two Linked Lists

Problem:
Given the heads of two singly linked lists, determine the node at which the two lists intersect.

If the two linked lists have no intersection, return null.

Example:
Input:
List A: 4 -> 1 -> 8 -> 4 -> 5
List B: 5 -> 6 -> 1 -> 8 -> 4 -> 5

Output:
8
*/

import java.util.*;

class Node {
  int d;
  Node next;

  Node(int x) {
    d=x;
  }
}

public class IntersectionOfLinkedLists {

  static Node find(Node a,Node b) {
    Node x=a,y=b;

    while(x!=y) {
      x=(x==null)?b:x.next;
      y=(y==null)?a:y.next;
    }

    return x;
  }

  static Node make(Scanner sc,int n) {
    Node h=null,t=null;

    for(int i=0;i<n;i++) {
      Node x=new Node(sc.nextInt());

      if(h==null) {
        h=x;
        t=x;
      }
      else {
        t.next=x;
        t=x;
      }
    }

    return h;
  }

  public static void main(String[] args) {
    Scanner sc=new Scanner(System.in);

    int n=sc.nextInt();
    Node a=make(sc,n);

    int m=sc.nextInt();
    Node b=make(sc,m);

    Node x=find(a,b);

    if(x==null)
      System.out.println("null");
    else
      System.out.println(x.d);
  }
}
